# ==============================================================================
# PINTU JAWARA — BRMP BANTEN (ENVIRONMENT CONFIGURATION TEMPLATE)
# Salin berkas ini ke .env atau .env.local dan isi nilai kredensial yang valid.
# ==============================================================================

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase PostgreSQL Database URL (Session Pooler Port 5432 / Transaction Pooler Port 6543)
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Application Session Secret (Min. 32 karakter acak heksadesimal)
AUTH_SECRET=your_32_characters_random_hex_secret

# WhatsApp Notification Gateway (Penyedia Fonnte / Wablas / Kemenag Gateway)
WA_GATEWAY_API_URL=https://api.fonnte.com/send
WA_GATEWAY_API_KEY=your_whatsapp_gateway_token

# Email SMTP Notification (Opsional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=notifikasi@brmpbanten.pertanian.go.id
# SMTP_PASS=your_app_password
